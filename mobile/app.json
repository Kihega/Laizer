{
  "expo": {
    "name": "Laizer",
    "slug": "laizer",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "smss",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smss.mobile"
    },
    "android": {
      "package": "com.smss.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1D4ED8"
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://laizer-mz7u.onrender.com",
      "eas": {
        "projectId": "7c261c77-30d2-4946-b85c-0f7fd6ef6d56"
      },
      "router": {}
    },
    "owner": "mangentechnologies-026"
  }
}
