/**
 * SMSS — Button Component
 */
import { ActivityIndicator, StyleSheet, Text, TouchableOpacity, TouchableOpacityProps, View, ViewStyle } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { BrandColors, Colors, FontSize, FontWeight, Radius, Spacing, Shadows } from '@/constants/theme';

type Variant = 'primary' | 'secondary' | 'accent' | 'danger' | 'ghost';
type Size    = 'sm' | 'md' | 'lg';

interface ButtonProps extends Omit<TouchableOpacityProps, 'style'> {
  label: string; variant?: Variant; size?: Size;
  loading?: boolean; icon?: React.ReactNode;
  fullWidth?: boolean; style?: ViewStyle;
}

const SIZES = {
  sm: { height: 38, fontSize: FontSize.sm,   paddingH: Spacing.md },
  md: { height: 48, fontSize: FontSize.base, paddingH: Spacing.base },
  lg: { height: 56, fontSize: FontSize.md,   paddingH: Spacing.xl },
};

const GRADIENTS: Record<string, [string, string]> = {
  primary: [BrandColors.blue,  BrandColors.blueDark],
  accent:  [BrandColors.teal,  '#065F46'],
  danger:  [Colors.error, '#991B1B'],
};

export function Button({ label, variant='primary', size='md', loading=false, disabled=false, icon, fullWidth=false, style, onPress, ...rest }: ButtonProps) {
  const sz         = SIZES[size];
  const isDisabled = disabled || loading;
  const isGradient = ['primary','accent','danger'].includes(variant);
  const isBordered = variant === 'secondary';
  const isGhost    = variant === 'ghost';

  const textColor = isBordered || isGhost ? Colors.primary : Colors.textInverse;

  const containerStyle: ViewStyle = {
    alignSelf: fullWidth ? 'stretch' : 'flex-start',
    borderRadius: Radius.md, overflow: 'hidden',
    opacity: isDisabled ? 0.55 : 1,
    ...(isBordered && { borderWidth:1.5, borderColor: Colors.primary, backgroundColor: Colors.white }),
    ...(isGhost    && { backgroundColor: 'transparent' }),
    ...(!isGradient && Shadows.sm),
    ...style,
  };

  const innerStyle: ViewStyle = {
    height: sz.height, flexDirection:'row', alignItems:'center',
    justifyContent:'center', gap: Spacing.xs, paddingHorizontal: sz.paddingH,
  };

  // When a gradient button is loading, always use white so the spinner is
  // visible against the blue/teal/red gradient background.
  const spinnerColor = isGradient ? Colors.white : textColor;
  const content = loading ? <ActivityIndicator color={spinnerColor} size="small" /> : (
    <>{icon && <View>{icon}</View>}<Text style={[S.label, { fontSize: sz.fontSize, color: textColor }]}>{label}</Text></>
  );

  return (
    <TouchableOpacity onPress={onPress} disabled={isDisabled} activeOpacity={loading ? 0.65 : 0.82} style={containerStyle} {...rest}>
      {isGradient
        // loading state: dim the real gradient (keeps button themed, spinner stays visible)
        ? <LinearGradient colors={loading ? ['rgba(0,0,0,0.18)','rgba(0,0,0,0.18)'] : isDisabled ? [Colors.grey300,Colors.grey300] : GRADIENTS[variant]} start={{x:0,y:0}} end={{x:1,y:0}} style={innerStyle}>{content}</LinearGradient>
        : <View style={innerStyle}>{content}</View>
      }
    </TouchableOpacity>
  );
}

const S = StyleSheet.create({ label: { fontWeight: FontWeight.bold, letterSpacing: 0.3 } });
