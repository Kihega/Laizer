// SMSS — Prisma Schema
// Database: PostgreSQL (Supabase free tier — data storage only)
// Run `npm run db:generate` after any schema change.
// Run `npm run db:migrate`  to apply migrations.

generator client {
  provider      = "prisma-client-js"
  // binaryTargets covers all common deployment environments:
  //   native                        → your local dev machine (auto-detected)
  //   linux-arm64-openssl-3.0.x     → Kali / Ubuntu 22.04+ ARM64
  //   debian-openssl-3.0.x          → Render free tier (Debian ARM64)
  //   linux-musl-openssl-3.0.x      → Alpine Linux (Docker)
  //   linux-musl-arm64-openssl-3.0.x→ Alpine Linux ARM64
  // native                         → local dev (auto-detected)
  // linux-musl-openssl-3.0.x        → Docker Alpine (container)
  // debian-openssl-3.0.x            → Render native (non-Docker)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  owner
  worker
}

enum StockUnit {
  pcs
  boxes
}

enum ServiceType {
  photocopy
  printing
  lamination
  scanning
  designing
  other
}

enum ServiceSubtype {
  black_and_white
  colour
}

enum NoticePriority {
  low
  normal
  urgent
}

// ── User ──────────────────────────────────────────────────────────────────────
// Stores both owners and workers.
// Owners authenticate with email + bcrypt password.
// Workers authenticate with centreId — no password needed.

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  fullName     String    @map("full_name")
  nim          String?   @unique
  passwordHash   String?   @map("password_hash")
  profilePicture String?   @map("profile_picture")  // base64 PNG, compressed ≤ 1 MB
  role         UserRole
  isActive     Boolean   @default(true)  @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt       @map("updated_at")

  ownedCentres    Centre[]
  assignments     WorkerCentreAssignment[]
  serviceEvents   ServiceEvent[]
  sentNotices     Notice[]
  noticeReads     NoticeRead[]
  pushTokens      ExpoPushToken[]
  registeredStock StockItem[]

  @@map("users")
}

// ── Centre ────────────────────────────────────────────────────────────────────

model Centre {
  id        String   @id @default(uuid())
  centreNo  String   @unique @map("centre_no")
  centreId  String   @unique @map("centre_id")
  name      String
  location  String
  ownerId   String   @map("owner_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  owner         User                     @relation(fields: [ownerId],   references: [id], onDelete: Cascade)
  assignments   WorkerCentreAssignment[]
  stockItems    StockItem[]
  serviceEvents ServiceEvent[]
  notices       Notice[]

  @@index([ownerId])
  @@map("centres")
}

// ── WorkerCentreAssignment ────────────────────────────────────────────────────

model WorkerCentreAssignment {
  id              String   @id @default(uuid())
  workerId        String   @map("worker_id")
  centreId        String   @map("centre_id")
  isActive        Boolean  @default(true) @map("is_active")
  assignedAt      DateTime @default(now()) @map("assigned_at")
  transferredFrom String?  @map("transferred_from")

  worker User   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([centreId])
  @@map("worker_centre_assignments")
}

// ── StockItem ─────────────────────────────────────────────────────────────────

model StockItem {
  id                String    @id @default(uuid())
  centreId          String    @map("centre_id")
  registeredBy      String?   @map("registered_by")
  itemName          String    @map("item_name")
  quantity          Decimal   @db.Decimal(10, 2)
  unit              StockUnit
  netStockPriceTshs Decimal   @db.Decimal(12, 2) @map("net_stock_price_tshs")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt          @map("updated_at")

  centre Centre @relation(fields: [centreId],     references: [id], onDelete: Cascade)
  worker User?  @relation(fields: [registeredBy], references: [id], onDelete: SetNull)

  @@index([centreId])
  @@map("stock_items")
}

// ── ServiceEvent ──────────────────────────────────────────────────────────────

model ServiceEvent {
  id               String          @id @default(uuid())
  centreId         String          @map("centre_id")
  workerId         String          @map("worker_id")
  serviceType      ServiceType     @map("service_type")
  serviceSubtype   ServiceSubtype? @map("service_subtype")
  category         String?
  pages            Int?
  pricePerPageTshs Decimal?        @db.Decimal(10, 2) @map("price_per_page_tshs")
  totalAmountTshs  Decimal         @db.Decimal(12, 2) @map("total_amount_tshs")
  customerNote     String?         @map("customer_note")
  createdAt        DateTime        @default(now()) @map("created_at")

  centre Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  worker User   @relation(fields: [workerId], references: [id])

  @@index([centreId])
  @@index([workerId])
  @@index([createdAt])
  @@map("service_events")
}

// ── Notice ────────────────────────────────────────────────────────────────────

model Notice {
  id        String         @id @default(uuid())
  senderId  String         @map("sender_id")
  centreId  String         @map("centre_id")
  title     String
  body      String
  priority  NoticePriority @default(normal)
  createdAt DateTime       @default(now()) @map("created_at")

  sender User         @relation(fields: [senderId], references: [id])
  centre Centre       @relation(fields: [centreId], references: [id], onDelete: Cascade)
  reads  NoticeRead[]

  @@index([centreId])
  @@map("notices")
}

// ── NoticeRead ────────────────────────────────────────────────────────────────

model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String   @map("notice_id")
  workerId String   @map("worker_id")
  readAt   DateTime @default(now()) @map("read_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  worker User   @relation(fields: [workerId], references: [id])

  @@unique([noticeId, workerId])
  @@index([workerId])
  @@map("notice_reads")
}

// ── ExpoPushToken ─────────────────────────────────────────────────────────────

model ExpoPushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("expo_push_tokens")
}

// ── BlacklistedToken ──────────────────────────────────────────────────────────

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}
