# ══════════════════════════════════════════════════════════════════
# Laizer API — Environment Variables
#
# LOCAL DEV (Termux / any machine without Docker)
# ─────────────────────────────────────────────────
#   1.  cp .env.example .env
#   2.  Fill in DATABASE_URL, DIRECT_URL, SECRET_KEY below
#   3.  npm install
#   4.  npm run setup          # generate Prisma + migrate + seed
#   5.  npm start              # → http://localhost:8000
#
#   To restart with auto-reload (if nodemon available):
#   5b. npm run dev
#
# RENDER (Docker — automatic)
# ─────────────────────────────────────────────────
#   Set these same variables in the Render dashboard.
#   The container runs  start.sh  which migrates then starts server.
#   You do NOT need Docker locally — it's only used on Render.
# ══════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# SMSS — Backend Environment Variables
# Copy this file to .env and fill in real values.
# This file IS committed to git — it has no real secrets.
# The actual .env is in .gitignore and must NEVER be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-secret

# ── Database (Supabase — use Transaction pooler URL, port 6543) ───────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Redis ───────────────────────────────────────────────────────────────────────
# Redis is NOT required. The backend uses an in-process Map cache.
# If you need distributed caching later, un-comment the line below
# and restore the original src/lib/redis.js.
# REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth ──────────────────────────────────────────────────────────────────────
OWNER_LOGIN_RATE_MAX=20

# ── Service edit window (ms) ──────────────────────────────────────────────────
# Default: 3600000 (60 minutes)
SERVICE_EDIT_WINDOW_MS=3600000
