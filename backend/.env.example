# ══════════════════════════════════════════════════════════════════════════════
# SMSS — Backend Environment Variables
# Copy this file to .env and fill in real values.
# This file IS committed to git — it has no real secrets.
# The actual .env is in .gitignore and must NEVER be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-secret

# ── Database (Supabase — use Transaction pooler URL, port 6543) ───────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Redis (Upstash free tier — copy TLS URL from Upstash dashboard) ──────────
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth ──────────────────────────────────────────────────────────────────────
OWNER_LOGIN_RATE_MAX=20

# ── Service edit window (ms) ──────────────────────────────────────────────────
# Default: 3600000 (60 minutes)
SERVICE_EDIT_WINDOW_MS=3600000
